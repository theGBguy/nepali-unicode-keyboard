{
  "sourceLanguage": "en",
  "strings": {
    "Cancel": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द गर्नुहोस्"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मेटाउनुहोस्"
          }
        }
      }
    },
    "Clear clipboard history": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड इतिहास मेटाउनुहोस्"
          }
        }
      }
    },
    "Clear clipboard history?": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड इतिहास मेटाउने?"
          }
        }
      }
    },
    "Clipboard history": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड इतिहास"
          }
        }
      }
    },
    "Dates, amounts and units as you type": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइप गर्दा मिति, रकम र एकाइ"
          }
        }
      }
    },
    "Full Access": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access"
          }
        }
      }
    },
    "How we handle your data": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हामी तपाईंको डेटा कसरी सम्हाल्छौं"
          }
        }
      }
    },
    "In Settings, tap Keyboards and turn on Nepali Keyboard.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिङमा Keyboards थिच्नुहोस् र Nepali Keyboard अन गर्नुहोस्।"
          }
        }
      }
    },
    "In any text field, hold 🌐 below the keyboard and pick Nepali Keyboard.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जुनसुकै टेक्स्ट फिल्डमा किबोर्डमुनिको 🌐 थिचिराख्नुहोस् र Nepali Keyboard छान्नुहोस्।"
          }
        }
      }
    },
    "I’ve set it up": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मैले सेटअप गरिसकें"
          }
        }
      }
    },
    "Key height": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कीको उचाइ"
          }
        }
      }
    },
    "Needs Full Access. Kept on this iPhone only.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access चाहिन्छ। यही iPhone मा मात्र रहन्छ।"
          }
        }
      }
    },
    "Nepali Keyboard": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नेपाली किबोर्ड"
          }
        }
      }
    },
    "Nepali typing": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नेपाली टाइपिङ"
          }
        }
      }
    },
    "Normal": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य"
          }
        }
      }
    },
    "Not showing? Hold 🌐 and pick Nepali Keyboard.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "देखिएन? 🌐 थिचिराख्नुहोस् र नेपाली किबोर्ड छान्नुहोस्।"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिङ खोल्नुहोस्"
          }
        }
      }
    },
    "Romanized": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रोमनाइज्ड"
          }
        }
      }
    },
    "Romanized or traditional layout. Takes about a minute to set up.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रोमनाइज्ड वा परम्परागत लेआउट। सेटअप गर्न करिब एक मिनेट लाग्छ।"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिङ"
          }
        }
      }
    },
    "Setup steps": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटअपका चरण"
          }
        }
      }
    },
    "Short": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "होचो"
          }
        }
      }
    },
    "Smart suggestions": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मार्ट सुझाव"
          }
        }
      }
    },
    "Sound on key press": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "की थिच्दा आवाज"
          }
        }
      }
    },
    "Source code": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सोर्स कोड"
          }
        }
      }
    },
    "Step %lld: %@": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "चरण %lld: %@"
          }
        }
      }
    },
    "Switch to it": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसमा स्विच गर्नुहोस्"
          }
        }
      }
    },
    "Tall": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अग्लो"
          }
        }
      }
    },
    "The अ/A key switches between Nepali and English. Hold it to change this choice later.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अ/A कीले नेपाली र अंग्रेजी बीच बदल्छ। यो छनोट पछि बदल्न त्यसलाई थिचिराख्नुहोस्।"
          }
        }
      }
    },
    "This removes every saved item, including pinned ones.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन गरिएका सहित सबै सेभ गरिएका कुरा हट्छन्।"
          }
        }
      }
    },
    "Traditional": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "परम्परागत"
          }
        }
      }
    },
    "Try it": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "चलाएर हेर्नुहोस्"
          }
        }
      }
    },
    "Turn on the keyboard": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "किबोर्ड अन गर्नुहोस्"
          }
        }
      }
    },
    "Type Nepali\nin any app": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जुनसुकै एपमा\nनेपाली लेख्नुहोस्"
          }
        }
      }
    },
    "Type “namaste” and press space": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "“namaste” टाइप गरी स्पेस थिच्नुहोस्"
          }
        }
      }
    },
    "Vibrate on key press": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "की थिच्दा कम्पन"
          }
        }
      }
    },
    "When keyboard sound is on in iPhone Settings": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone सेटिङमा किबोर्डको आवाज खुला हुँदा"
          }
        }
      }
    }
  },
  "version": "1.0"
}
