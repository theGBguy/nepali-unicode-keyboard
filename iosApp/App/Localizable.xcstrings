{
  "sourceLanguage": "en",
  "strings": {
    "Added": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "थपिएको छ"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एप"
          }
        }
      }
    },
    "App language": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एपको भाषा"
          }
        }
      }
    },
    "Bikram Sambat calendar": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "विक्रम संवत् पात्रो"
          }
        }
      }
    },
    "Built with SwiftUI and Kotlin Multiplatform. Kotlin and google-mlkit-swiftpm (handwriting) are available under the Apache License 2.0; Google ML Kit is under Google’s ML Kit terms.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftUI र Kotlin Multiplatform प्रयोग गरी बनाइएको। Kotlin र google-mlkit-swiftpm (हस्तलिपि) Apache License 2.0 अन्तर्गत उपलब्ध छन्; Google ML Kit Google का ML Kit सर्तअन्तर्गत छ।"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द गर्नुहोस्"
          }
        }
      }
    },
    "Choose how you type Nepali below, then type in the field.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तल नेपाली कसरी टाइप गर्ने छान्नुहोस्, अनि फिल्डमा टाइप गर्नुहोस्।"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मेटाउनुहोस्"
          }
        }
      }
    },
    "Clear clipboard history": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड इतिहास मेटाउनुहोस्"
          }
        }
      }
    },
    "Clear clipboard history?": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड इतिहास मेटाउने?"
          }
        }
      }
    },
    "Clipboard history": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड इतिहास"
          }
        }
      }
    },
    "Contains word frequencies derived from Nepali Wikipedia (ne.wikipedia.org), available under the Creative Commons Attribution-ShareAlike 4.0 licence (CC BY-SA 4.0).": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसमा नेपाली विकिपिडिया (ne.wikipedia.org) बाट निकालिएको शब्द आवृत्ति समावेश छ, जुन Creative Commons Attribution-ShareAlike 4.0 (CC BY-SA 4.0) लाइसेन्सअन्तर्गत उपलब्ध छ।"
          }
        }
      }
    },
    "Dates, amounts and units as you type": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइप गर्दा मिति, रकम र एकाइ"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "भयो"
          }
        }
      }
    },
    "Emoji list": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "इमोजी सूची"
          }
        }
      }
    },
    "Emoji list derived from Unicode emoji data, © Unicode, Inc., under the Unicode License v3. Emoji are drawn by your iPhone’s font.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "इमोजी सूची Unicode इमोजी डेटाबाट लिइएको, © Unicode, Inc., Unicode License v3 अन्तर्गत। इमोजी तपाईंको iPhone को फन्टले देखाउँछ।"
          }
        }
      }
    },
    "Full Access": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access"
          }
        }
      }
    },
    "Handwriting (uses Google)": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्तलिपि (Google प्रयोग गर्छ)"
