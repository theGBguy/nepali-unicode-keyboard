    },
    "Month lengths for BS 2000–2090 from nepali-date-pro-max by l3lackcurtains, under the MIT licence.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "वि.सं. २००० देखि २०९० सम्मका महिनाका दिन l3lackcurtains को nepali-date-pro-max बाट, MIT licence अन्तर्गत।"
          }
        }
      }
    },
    "Needs Full Access for the model download": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मोडेल डाउनलोड गर्न Full Access चाहिन्छ"
