    "Writing area": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "लेख्ने ठाउँ"
          }
        }
      }
    },
    "Writing is recognised on this iPhone. Turning it on downloads Google’s Nepali handwriting model (about 15 MB) once, and Google’s ML Kit then sends Google usage diagnostics such as phone model and app version, never what you write. Turning it off in the app’s Settings deletes the model.": {
      "localizations": {
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखाइ यही iPhone मा पहिचान हुन्छ। खोल्दा Google को नेपाली हस्तलिपि मोडेल (करिब १५ MB) एक पटक डाउनलोड हुन्छ, अनि Google को ML Kit ले फोनको मोडेल, एपको संस्करण जस्ता प्रयोग विवरण Google लाई पठाउँछ, तपाईंले लेखेको कुरा कहिल्यै होइन। एपको सेटिङमा बन्द गर्दा मोडेल मेटिन्छ।"
          }
        }
      }
    },
