<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer, Android 12+. Settings and recently used emoji go along;
   clipboard history stays on the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="file" path="clipboard.txt" />
        <exclude domain="file" path="clipboard.txt.tmp" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="file" path="clipboard.txt" />
        <exclude domain="file" path="clipboard.txt.tmp" />
    </device-transfer>
</data-extraction-rules>
