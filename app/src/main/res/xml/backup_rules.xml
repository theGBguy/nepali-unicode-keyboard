<?xml version="1.0" encoding="utf-8"?>
<!--
   Android Auto Backup, Android 11 and older (data_extraction_rules.xml covers 12+).
   Settings and recently used emoji are backed up; clipboard history stays on the phone.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <exclude domain="file" path="clipboard.txt" />
    <exclude domain="file" path="clipboard.txt.tmp" />
</full-backup-content>
